<Project>
  <!-- Shared by both Windows hosts, including direct dotnet build/publish. -->
  <PropertyGroup>
    <NativeDashboardBuildDirectory Condition="'$(NativeDashboardBuildDirectory)' == ''">$(MSBuildThisFileDirectory)native-dashboard\production</NativeDashboardBuildDirectory>
    <_NativeDashboardEnabled Condition="'$(OS)' == 'Windows_NT' and '$(TargetFramework)' == 'net10.0-windows' and '$(DesignTimeBuild)' != 'true' and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64') and '$(PlatformTarget)' != 'x86' and '$(PlatformTarget)' != 'ARM64'">true</_NativeDashboardEnabled>
  </PropertyGroup>
  <Target Name="BuildNativeDashboard" BeforeTargets="PrepareForBuild" Condition="'$(_NativeDashboardEnabled)' == 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)build_native_dashboard.ps1&quot; -BuildDirectory &quot;$(NativeDashboardBuildDirectory)&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)build_native_dashboard.ps1&quot; -BuildDirectory &quot;$(NativeDashboardBuildDirectory)-x86&quot; -Architecture x86" />
  </Target>
  <Target Name="CollectNativeDashboard" DependsOnTargets="BuildNativeDashboard" Condition="'$(_NativeDashboardEnabled)' == 'true'">
    <Error Condition="!Exists('$(NativeDashboardBuildDirectory)\Release\ztmz_dashboard_overlay.dll')" Text="Production native dashboard DLL is missing." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\src\ZTMZ.PacenoteTool.WebDashboard\fonts\WRCCleanRoman.ttf') or !Exists('$(MSBuildThisFileDirectory)..\src\ZTMZ.PacenoteTool.WebDashboard\fonts\WRCCleanBold.ttf')" Text="Native dashboard font bundle is incomplete." />
    <ItemGroup>
      <_NativeDashboardFiles Include="$(NativeDashboardBuildDirectory)\Release\ztmz_dashboard_overlay.dll">
        <BundlePath>win-x64\ztmz_dashboard_overlay.dll</BundlePath>
      </_NativeDashboardFiles>
      <_NativeDashboardFiles Include="$(NativeDashboardBuildDirectory)\Release\licenses\volk.txt">
        <BundlePath>win-x64\licenses\volk.txt</BundlePath>
      </_NativeDashboardFiles>
      <_NativeDashboardFiles Include="$(NativeDashboardBuildDirectory)-x86\Release\ztmz_dashboard_overlay.dll">
        <BundlePath>win-x86\ztmz_dashboard_overlay.dll</BundlePath>
      </_NativeDashboardFiles>
      <_NativeDashboardFiles Include="$(NativeDashboardBuildDirectory)-x86\Release\ztmz_dashboard_injector.exe">
        <BundlePath>win-x86\ztmz_dashboard_injector.exe</BundlePath>
      </_NativeDashboardFiles>
      <_NativeDashboardFiles Include="$(NativeDashboardBuildDirectory)-x86\Release\licenses\volk.txt">
        <BundlePath>win-x86\licenses\volk.txt</BundlePath>
      </_NativeDashboardFiles>
    </ItemGroup>
  </Target>
  <Target Name="StageDevelopmentNativeDashboard" AfterTargets="Build" DependsOnTargets="CollectNativeDashboard" Condition="'$(_NativeDashboardEnabled)' == 'true'">
    <Copy SourceFiles="@(_NativeDashboardFiles)" DestinationFiles="@(_NativeDashboardFiles->'$(OutDir)native-dashboard\%(BundlePath)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishNativeDashboard" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="CollectNativeDashboard" Condition="'$(_NativeDashboardEnabled)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_NativeDashboardFiles)">
        <RelativePath>native-dashboard\%(_NativeDashboardFiles.BundlePath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <!-- Check the actual output, not just source assets: both desktop hosts must
       publish the shared fonts beside the host, where the injected DLL finds them. -->
  <Target Name="ValidatePublishedNativeDashboard" AfterTargets="Publish" Condition="'$(_NativeDashboardEnabled)' == 'true'">
    <Error Condition="!Exists('$(PublishDir)native-dashboard\win-x86\ztmz_dashboard_overlay.dll') or !Exists('$(PublishDir)native-dashboard\win-x86\ztmz_dashboard_injector.exe')" Text="Published x86 native dashboard DLL/injector is missing. Do not package this output." />
    <Error Condition="!Exists('$(PublishDir)native-dashboard\win-x64\ztmz_dashboard_overlay.dll')" Text="Published native dashboard DLL is missing. Do not package this output." />
    <Error Condition="!Exists('$(PublishDir)fonts\WRCCleanRoman.ttf') or !Exists('$(PublishDir)fonts\WRCCleanBold.ttf')" Text="Published shared WRC fonts are missing. Do not package this output." />
  </Target>
</Project>
