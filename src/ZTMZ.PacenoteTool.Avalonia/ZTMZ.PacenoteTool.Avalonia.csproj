    <Content Include="..\ZTMZ.PacenoteTool.Codemasters\dirtrally.jpg">
      <Link>Assets\Games\dirtrally.jpg</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\ZTMZ.PacenoteTool.Codemasters\dirtrally2.jpg">
      <Link>Assets\Games\dirtrally2.jpg</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\ZTMZ.PacenoteTool.Codemasters\wrc.jpg">
      <Link>Assets\Games\wrc.jpg</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
