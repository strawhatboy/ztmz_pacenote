<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <AssemblyName>com.ztmz.PacenoteTool</AssemblyName>
    <AssemblyVersion>$(ZtmzAvaloniaVersion)</AssemblyVersion>
    <PackageVersion>$(ZtmzAvaloniaVersion)</PackageVersion>
    <Version>$(ZtmzAvaloniaVersion)</Version>
    <FileVersion>$(ZtmzAvaloniaVersion)</FileVersion>
    <ApplicationManifest Condition="'$(OS)' == 'Windows_NT'">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">..\ZTMZ.PacenoteTool.WpfGUI\Assets\app.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZTMZ.PacenoteTool.Avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.3-nightly.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZTMZ.PacenoteTool.Platform.Windows\ZTMZ.PacenoteTool.Platform.Windows.csproj" Condition="'$(OS)' == 'Windows_NT'" />
    <ProjectReference Include="..\ZTMZ.PacenoteTool.Platform.Linux\ZTMZ.PacenoteTool.Platform.Linux.csproj" Condition="'$(OS)' != 'Windows_NT'" />
    <ProjectReference Include="..\ZTMZ.PacenoteTool.Base\ZTMZ.PacenoteTool.Base.csproj" AdditionalProperties="ExcludeSevenZipAssemblies=true" />
    <ProjectReference Include="..\ZTMZ.PacenoteTool.Audio.PortAudio\ZTMZ.PacenoteTool.Audio.PortAudio.csproj" />
    <ProjectReference Include="..\ZTMZ.PacenoteTool.Core\ZTMZ.PacenoteTool.Core.csproj" />
    <ProjectReference Include="..\ZTMZ.PacenoteTool.ScriptEditor.Core\ZTMZ.PacenoteTool.ScriptEditor.Core.csproj" />
    <ProjectReference Include="..\ZTMZ.PacenoteTool.WebDashboard\ZTMZ.PacenoteTool.WebDashboard.csproj" />
    <ProjectReference Include="..\ZTMZ.PacenoteTool.Codemasters\ZTMZ.PacenoteTool.Codemasters.csproj" ReferenceOutputAssembly="false" AdditionalProperties="TargetFramework=net10.0" />
    <ProjectReference Include="..\ZTMZ.PacenoteTool.BeamNG\ZTMZ.PacenoteTool.BeamNG.csproj" Condition="'$(OS)' == 'Windows_NT'" ReferenceOutputAssembly="false" AdditionalProperties="TargetFramework=net10.0" />
    <ProjectReference Include="..\ZTMZ.PacenoteTool.AC\ZTMZ.PacenoteTool.AC.csproj" ReferenceOutputAssembly="false" AdditionalProperties="TargetFramework=net10.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="lang\*.json">
      <Link>resources\lang\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\ZTMZ.PacenoteTool.WpfGUI\Assets\app.png">
      <Link>Assets\app.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\ZTMZ.PacenoteTool.WpfGUI\Assets\app_tray.ico">
      <Link>Assets\app_tray.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\ZTMZ.PacenoteTool.WpfGUI\Assets\app.ico">
