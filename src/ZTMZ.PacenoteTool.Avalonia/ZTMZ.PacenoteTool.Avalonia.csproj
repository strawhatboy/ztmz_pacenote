    <Content Include="..\ZTMZ.PacenoteTool.Base\data.zdb">
      <Link>resources\data.zdb</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\ZTMZ.PacenoteTool.ScriptEditor\Assets\Monaco\**\*"
             Exclude="..\ZTMZ.PacenoteTool.ScriptEditor\Assets\Monaco\min\vs\basic-languages\**\*;..\ZTMZ.PacenoteTool.ScriptEditor\Assets\Monaco\min\vs\language\**\*;..\ZTMZ.PacenoteTool.ScriptEditor\Assets\Monaco\min\vs\nls.messages.*.js">
      <Link>Assets\Monaco\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\ZTMZ.PacenoteTool.WebDashboard\pacenote-icons\**\*">
      <Link>Assets\PacenoteIcons\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\ZTMZ.PacenoteTool.I18N\lang\*.json">
      <Link>resources\lang\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="StageAvaloniaGameProviders" AfterTargets="Build">
    <PropertyGroup>
      <CodemastersOutput>$(MSBuildProjectDirectory)\..\ZTMZ.PacenoteTool.Codemasters\bin\$(Configuration)\net10.0</CodemastersOutput>
      <BeamNgOutput>$(MSBuildProjectDirectory)\..\ZTMZ.PacenoteTool.BeamNG\bin\$(Configuration)\net10.0</BeamNgOutput>
      <AcrOutput>$(MSBuildProjectDirectory)\..\ZTMZ.PacenoteTool.AC\bin\$(Configuration)\net10.0</AcrOutput>
    </PropertyGroup>
    <ItemGroup>
      <GameProviderBinaries Include="$(CodemastersOutput)\ZTMZ.PacenoteTool.Codemasters.dll" />
      <GameProviderLanguages Include="$(CodemastersOutput)\lang\*.json" />
      <GameProviderBinaries Include="$(BeamNgOutput)\ZTMZ.PacenoteTool.BeamNG.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <GameProviderLanguages Include="$(BeamNgOutput)\lang\*.json" Condition="'$(OS)' == 'Windows_NT'" />
      <BeamNgModFiles Include="$(BeamNgOutput)\BeamNGMod\**\*" Condition="'$(OS)' == 'Windows_NT'" />
      <GameProviderBinaries Include="$(AcrOutput)\ZTMZ.PacenoteTool.AC.dll" />
      <GameProviderLanguages Include="$(AcrOutput)\lang\*.json" />
      <AcrBridgeFiles Include="$(AcrOutput)\ACRExperimentalBridge\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)games;$(OutDir)games\lang" />
    <Copy SourceFiles="@(GameProviderBinaries)" DestinationFolder="$(OutDir)games" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GameProviderLanguages)" DestinationFolder="$(OutDir)games\lang" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BeamNgModFiles)" DestinationFiles="@(BeamNgModFiles->'$(OutDir)games\BeamNGMod\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(BeamNgModFiles)' != ''" />
    <Copy SourceFiles="@(AcrBridgeFiles)" DestinationFiles="@(AcrBridgeFiles->'$(OutDir)games\ACRExperimentalBridge\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(AcrBridgeFiles)' != ''" />
  </Target>

  <Target Name="StageAvaloniaGameProvidersInPublish"
          AfterTargets="Publish"
          DependsOnTargets="StageAvaloniaGameProviders">
    <MakeDir Directories="$(PublishDir)games;$(PublishDir)games\lang" />
    <Copy SourceFiles="@(GameProviderBinaries)" DestinationFolder="$(PublishDir)games" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GameProviderLanguages)" DestinationFolder="$(PublishDir)games\lang" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BeamNgModFiles)" DestinationFiles="@(BeamNgModFiles->'$(PublishDir)games\BeamNGMod\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(BeamNgModFiles)' != ''" />
    <Copy SourceFiles="@(AcrBridgeFiles)" DestinationFiles="@(AcrBridgeFiles->'$(PublishDir)games\ACRExperimentalBridge\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(AcrBridgeFiles)' != ''" />
  </Target>

</Project>
