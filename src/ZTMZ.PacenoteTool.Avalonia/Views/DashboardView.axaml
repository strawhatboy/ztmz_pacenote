<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ZTMZ.PacenoteTool.Avalonia.Views.DashboardView">
  <ScrollViewer>
    <Grid Margin="42,28,42,40"
          HorizontalAlignment="Stretch"
          RowDefinitions="Auto,Auto,Auto,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource tabs.dashboard}"
                   FontSize="28"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding DashboardStatus}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>

      <Border Grid.Row="1" Classes="search-setting"
              Margin="0,28,0,0"
              Padding="16"
              IsVisible="{Binding IsNativeOverlaySupported}"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="4">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource settings.overlayHudTitle}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource settings.tooltip.overlayHudHomeStatus}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1"
                        IsChecked="{Binding IsNativeOverlayEnabled, Mode=TwoWay}"
                        OnContent=""
                        OffContent=""
                        ToolTip.Tip="{DynamicResource settings.tooltip.overlayHudEnabled}" />
          <Grid Grid.Row="1" Grid.ColumnSpan="2"
                ColumnDefinitions="Auto,Auto,60,*" ColumnSpacing="10">
            <TextBlock Text="{DynamicResource settings.hudFPS}"
                       VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding IsNativeOverlayFrameRateLocked, Mode=TwoWay}"
                          OnContent=""
                          OffContent=""
                          ToolTip.Tip="{DynamicResource settings.tooltip.hudFPS}" />
            <TextBlock Grid.Column="2"
                       Text="{Binding NativeOverlayFrameRate}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Slider Grid.Column="3"
                    Minimum="30"
                    Maximum="240"
                    IsEnabled="{Binding IsNativeOverlayFrameRateLocked}"
                    Value="{Binding NativeOverlayFrameRate, Mode=TwoWay}" />
          </Grid>
          <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
            <TextBlock Text="{DynamicResource settings.hudTopMost}"
                       IsVisible="{Binding ShowOverlayTopMost}"
                       VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding IsNativeOverlayTopMost, Mode=TwoWay}"
                          IsVisible="{Binding ShowOverlayTopMost}"
                          OnContent=""
                          OffContent=""
                          ToolTip.Tip="{DynamicResource settings.tooltip.hudTopMost}" />
            <ProgressBar Grid.Column="2"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsNativeOverlayInitializing}"
                         VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" Fill="{Binding NativeOverlayStatusBrush}" />
              <TextBlock Text="{Binding NativeOverlayStatus}" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,240" RowDefinitions="Auto,Auto,Auto"
                RowSpacing="8" ColumnSpacing="12">
            <TextBlock Text="{DynamicResource overlayBackend.title}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                      SelectedIndex="{Binding OverlayBackendIndex, Mode=TwoWay}">
              <ComboBoxItem Content="{DynamicResource overlayBackend.window}" />
              <ComboBoxItem Content="{DynamicResource overlayBackend.inGame}" />
            </ComboBox>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="6">
              <TextBlock x:Name="OverlayBackendStatusText" Text="{Binding OverlayBackendStatus}" TextWrapping="Wrap" />
              <StackPanel x:Name="OverlayFailurePanel" IsVisible="{Binding HasOverlayFailure}" Spacing="8">
                <TextBlock x:Name="OverlayFailurePathText" Text="{Binding OverlayFailureComponentPath}" TextWrapping="Wrap" />
                <Expander x:Name="OverlayDiagnosticsExpander" Header="{DynamicResource diagnostics.title}">
                  <TextBox x:Name="OverlayFailureDiagnosticsText" Text="{Binding OverlayFailureDiagnostics, Mode=OneWay}"
                           IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240"
                           ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Expander>
                <Button x:Name="CopyOverlayDiagnosticsButton" Content="{DynamicResource overlayBackend.copyDiagnostics}"
                        HorizontalAlignment="Left" Click="CopyOverlayDiagnostics_Click" />
              </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{DynamicResource overlayBackend.injectionNote}"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Row="2" Classes="search-setting"
              Margin="0,28,0,0"
              Padding="16"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="4">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource settings.tooltip.webDashboardTitle}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource settings.tooltip.webDashboardSubtitle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1"
                        IsChecked="{Binding IsWebDashboardEnabled, Mode=TwoWay}"
                        OnContent=""
                        OffContent="" />
          <Grid Grid.Row="1"
                Grid.ColumnSpan="2"
                ColumnDefinitions="Auto,*,Auto,160"
                ColumnSpacing="10">
            <Button HorizontalContentAlignment="Stretch"
                    Command="{Binding OpenDashboardCommand}"
                    ToolTip.Tip="{DynamicResource settings.tooltip.webDashboardOpen}"
                    ToolTip.ShowDelay="100">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Ellipse Width="8" Height="8" Fill="{Binding DashboardStatusBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DashboardDisplayUrl}"
                           TextTrimming="CharacterEllipsis" />
                <materialIcons:MaterialIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16" />
              </Grid>
            </Button>
            <TextBlock Grid.Column="2"
                       Text="{DynamicResource settings.tooltip.webDashboardCanvasResolutionLabel}"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding WebDashboardCanvasResolutionOptions}"
                      SelectedItem="{Binding WebDashboardCanvasResolution, Mode=TwoWay}"
                      ToolTip.Tip="{DynamicResource settings.tooltip.webDashboardCanvasResolution}" />
          </Grid>
          <Grid Grid.Row="2"
                Grid.ColumnSpan="2"
                ColumnDefinitions="Auto,120,Auto,50,*"
                ColumnSpacing="10">
            <TextBlock Text="{DynamicResource settings.tooltip.webDashboardPortLabel}"
                       VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1"
                           Minimum="1024"
                           Maximum="65535"
                           Value="{Binding WebDashboardPort, Mode=TwoWay}" />
            <TextBlock Grid.Column="2"
                       Text="{DynamicResource settings.tooltip.webDashboardFrameRateLabel}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3"
                       Text="{Binding WebDashboardFrameRate}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Slider Grid.Column="4"
                    Minimum="5"
                    Maximum="240"
                    Value="{Binding WebDashboardFrameRate, Mode=TwoWay}" />
          </Grid>
        </Grid>
      </Border>

      <ItemsControl Grid.Row="3"
                    Margin="0,18,0,0"
                    ItemsSource="{Binding Dashboards}">
        <ItemsControl.Styles>
          <Style Selector="ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    Padding="10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
              <Grid RowDefinitions="Auto,Auto">
                <ToggleButton x:Name="SettingsExpander"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0">
                <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="14">
                  <Border Height="82"
                        Background="#111111"
                        CornerRadius="3"
                        ClipToBounds="True">
                    <Image Source="{Binding PreviewImage}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Version}"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock Text="{Binding Author}"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                  <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{DynamicResource dashboards.settings.tooltip.outputTarget}">
                      <ToggleButton IsChecked="{Binding IsOutputOff, Mode=TwoWay}"
                                    ToolTip.Tip="{DynamicResource dashboards.settings.tooltip.outputTargetOff}">
                        <materialIcons:MaterialIcon Kind="EyeOffOutline" Width="16" Height="16" />
                      </ToggleButton>
                      <ToggleButton IsChecked="{Binding IsOutputOverlay, Mode=TwoWay}"
                                    ToolTip.Tip="{DynamicResource dashboards.settings.tooltip.outputTargetOverlay}">
                        <materialIcons:MaterialIcon Kind="DesktopClassic" Width="16" Height="16" />
                      </ToggleButton>
                      <ToggleButton IsChecked="{Binding IsOutputWeb, Mode=TwoWay}"
                                    ToolTip.Tip="{DynamicResource dashboards.settings.tooltip.outputTargetWeb}">
                        <materialIcons:MaterialIcon Kind="Web" Width="16" Height="16" />
                      </ToggleButton>
                      <ToggleButton IsChecked="{Binding IsOutputBoth, Mode=TwoWay}"
                                    ToolTip.Tip="{DynamicResource dashboards.settings.tooltip.outputTargetBoth}">
                        <materialIcons:MaterialIcon Kind="ViewDashboardOutline" Width="16" Height="16" />
                      </ToggleButton>
                    </StackPanel>
                    <materialIcons:MaterialIcon Grid.Column="1"
                                                Kind="ChevronDown"
                                                Width="18" Height="18"
                                                VerticalAlignment="Center" />
                  </Grid>
                </Grid>
                </ToggleButton>
                <ItemsControl Grid.Row="1"
                              Margin="0,14,0,2"
                              IsVisible="{Binding IsChecked, ElementName=SettingsExpander}"
                              ItemsSource="{Binding Settings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,10" ColumnDefinitions="*,260" ColumnSpacing="14">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding Tooltip}"
                                   FontSize="{DynamicResource AppSmallFontSize}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" IsVisible="{Binding IsBoolean}"
                                    HorizontalAlignment="Left"
                                    IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                    OnContent="" OffContent="" />
                      <ComboBox Grid.Column="1" IsVisible="{Binding IsHorizontalPosition}"
                                ItemsSource="{Binding HorizontalPositions}"
                                SelectedIndex="{Binding PositionIndex, Mode=TwoWay}" />
                      <ComboBox Grid.Column="1" IsVisible="{Binding IsVerticalPosition}"
                                ItemsSource="{Binding VerticalPositions}"
                                SelectedIndex="{Binding PositionIndex, Mode=TwoWay}" />
                      <TextBox Grid.Column="1" IsVisible="{Binding IsText}"
                               Text="{Binding TextValue, Mode=TwoWay}" />
                      <NumericUpDown Grid.Column="1" IsVisible="{Binding IsPlainNumeric}"
                                     Value="{Binding NumericValue, Mode=TwoWay}" />
                      <Grid Grid.Column="1" IsVisible="{Binding IsRangedNumeric}"
                            ColumnDefinitions="50,*" ColumnSpacing="8">
                        <TextBlock Text="{Binding NumericValue, StringFormat={}{0:0.##}}"
                                   VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="{Binding ValueRange[0]}"
                                Maximum="{Binding ValueRange[1]}"
                                Value="{Binding NumericValue, Mode=TwoWay}" />
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </ScrollViewer>
</UserControl>
