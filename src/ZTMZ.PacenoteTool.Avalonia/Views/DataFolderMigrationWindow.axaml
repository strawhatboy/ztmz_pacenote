<fa:FAAppWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:fa="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
                xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                x:Class="ZTMZ.PacenoteTool.Avalonia.Views.DataFolderMigrationWindow"
                Width="620" Height="280" MinWidth="620" MinHeight="280"
                CanResize="False" WindowStartupLocation="CenterScreen">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <materialIcons:MaterialIcon Kind="FolderMoveOutline" Width="26" Height="26" />
      <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,20,0,10" TextWrapping="Wrap" />
    <ProgressBar x:Name="MigrationProgress" Grid.Row="2" Height="8" Minimum="0" Maximum="100" />
    <TextBlock x:Name="DetailText" Grid.Row="3" Margin="0,10,0,0" Opacity="0.75"
               TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
    <StackPanel Grid.Row="4" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
      <Button x:Name="RestartButton" Click="Restart_Click" IsVisible="False" />
      <Button x:Name="CloseButton" Click="Close_Click" />
    </StackPanel>
  </Grid>
</fa:FAAppWindow>
