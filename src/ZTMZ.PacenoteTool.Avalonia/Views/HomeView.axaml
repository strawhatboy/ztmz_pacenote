<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ZTMZ.PacenoteTool.Avalonia.Views.HomeView">
  <Grid RowDefinitions="Auto,*,Auto">
    <fa:FAInfoBar Margin="42,0"
                  IsOpen="{Binding HasError}"
                  Severity="Error"
                  Title="{DynamicResource runtime.initializationFailed}"
                  Message="{Binding ErrorMessage}" />

    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Margin="42,0,42,24"
             ColumnDefinitions="480,*">
        <StackPanel Grid.Column="0"
                    Margin="0,40,20,0"
                    Spacing="20">
          <Grid Height="210"
                RowDefinitions="150,60"
                ColumnDefinitions="150,*,250">
            <Image Width="130"
                   Height="130"
                   Source="{Binding AppLogo}"
                   Stretch="Uniform"
                   UseLayoutRounding="True"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

            <Border Grid.Column="1"
                    Height="4"
                    Background="{Binding GameStatusBrush}"
                    CornerRadius="2"
                    VerticalAlignment="Center" />

            <Border Grid.Column="2"
                    Width="250"
                    Height="130"
                    Padding="12"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{Binding GameStatusBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ToolTip.Tip="{Binding ActiveGameDescription}"
                    ToolTip.ShowDelay="100">
              <Grid>
                <Image Source="{Binding ActiveGameImage}"
                       IsVisible="{Binding HasActiveGameImage}"
                       Stretch="Uniform"
                       UseLayoutRounding="True"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                <materialIcons:MaterialIcon Kind="RacingHelmet"
                                 IsVisible="{Binding ShowsGamePlaceholder}"
                                 Width="48" Height="48"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
              </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
              <Ellipse Width="8" Height="8" Fill="{Binding GameStatusBrush}" />
              <TextBlock Text="{Binding ActiveGameName}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding GameConnectionStatus}"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </Grid>

          <Expander IsExpanded="True"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16">
            <Expander.Header>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <materialIcons:MaterialIcon Kind="ViewDashboard" Width="26" Height="26" />
                  <TextBlock Text="{DynamicResource settings.overlayHudTitle}"
                             FontSize="15"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Margin="12,0"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8" Fill="{Binding DashboardStatusBrush}" />
                  <TextBlock Text="{Binding DashboardStatus}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </Grid>
            </Expander.Header>
            <Grid Margin="0,14,0,0"
                  Height="82"
                  HorizontalAlignment="Stretch"
                  ColumnDefinitions="*,*,*,*,*,*">
              <Border Grid.Column="0" Background="#609D51" />
              <Border Grid.Column="1" Background="#D3A95B" />
              <Border Grid.Column="2" Background="#B9574A" />
              <Border Grid.Column="3" Background="#B9574A" />
              <Border Grid.Column="4" Background="#D3A95B" />
              <Border Grid.Column="5" Background="#609D51" />
              <TextBlock Grid.ColumnSpan="6"
                         Text="6"
                         FontSize="42"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <Button Grid.ColumnSpan="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      BorderThickness="0"
                      Cursor="Hand"
                      Command="{Binding OpenDashboardSettingsCommand}"
                      ToolTip.Tip="{DynamicResource settings.tooltip.overlayHudUsage}"
                      ToolTip.ShowDelay="100" />
            </Grid>
          </Expander>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Margin="0,40,0,0">
          <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4">
            <StackPanel>
              <Grid Margin="16"
                    RowDefinitions="Auto,Auto"
                    ColumnDefinitions="Auto,*"
                    RowSpacing="10">
                <StackPanel Grid.RowSpan="2"
                            Margin="0,0,16,0"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                  <materialIcons:MaterialIcon Kind="AccountVoice" Width="28" Height="28" />
                  <TextBlock Text="{DynamicResource ui.tab_s_audioPackage}"
                             FontSize="15"
                             FontWeight="SemiBold"
                             TextAlignment="Center" />
                </StackPanel>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding CoDrivers}"
                          SelectedItem="{Binding SelectedCoDriver, Mode=TwoWay}"
                          ToolTip.Tip="{Binding SelectedCoDriver.Description}"
                          ToolTip.ShowDelay="100"
                          HorizontalAlignment="Stretch"
                          IsEnabled="{Binding IsReady}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                       <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.RowSpan="2"
                                   Text="{Binding GenderSymbol}"
                                   Foreground="{Binding GenderBrush}"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding Language}"
                                     FontSize="{DynamicResource AppSmallFontSize}"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                          <TextBlock Text="{Binding Version}"
                                     FontSize="{DynamicResource AppSmallFontSize}"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <WrapPanel Grid.Row="1"
                           Grid.Column="1"
                           HorizontalAlignment="Stretch">
                  <Button Margin="0,0,10,8" Command="{Binding PlayExampleCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <materialIcons:MaterialIcon Kind="Play" Width="16" Height="16" />
                      <TextBlock Text="{DynamicResource ui.btn_playExample}" />
                    </StackPanel>
                  </Button>
                  <Button Margin="0,0,10,8" Command="{Binding OpenCoDriverHomePageCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <materialIcons:MaterialIcon Kind="Link" Width="16" Height="16" />
                      <TextBlock Text="{DynamicResource ui.tb_codriverLink}" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding OpenCoDriverFolderCommand}"
                          Margin="0,0,10,8"
                          ToolTip.Tip="{DynamicResource ui.tooltip.btn_currentCodriver}"
                          ToolTip.ShowDelay="100">
                    <materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16" />
                  </Button>
                  <Button Margin="0,0,10,8" Command="{Binding MoreCoDriverSettingsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16" />
                      <TextBlock Text="{DynamicResource settings.more}" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </Grid>

              <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,1,0,0">
                <Grid Margin="16"
                      RowDefinitions="44,44,44,44,44,44,44"
                      ColumnDefinitions="150,56,*">
                  <TextBlock Text="{DynamicResource ui.tb_currentTrack}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Grid.ColumnSpan="2"
                             Text="{Binding CurrentTrack}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             VerticalAlignment="Center" />

                  <TextBlock Grid.Row="1"
                             Text="{DynamicResource ui.tb_replayDevice}"
                             ToolTip.Tip="{DynamicResource ui.tooltip.tb_replayDevice}"
                             ToolTip.ShowDelay="100"
                             VerticalAlignment="Center" />
                  <ComboBox Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            ItemsSource="{Binding OutputDevices}"
                            SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                            DisplayMemberBinding="{Binding DisplayName}" />

                  <TextBlock Grid.Row="2"
                             Text="{DynamicResource ui.tb_playVolume}"
                             ToolTip.Tip="{DynamicResource ui.tooltip.tb_playVolume}"
                             ToolTip.ShowDelay="100"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="2"
                             Grid.Column="1"
                             Text="{Binding PlaybackVolume, StringFormat={}{0:F0}}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                  <Slider Grid.Row="2"
                          Grid.Column="2"
                          Minimum="0"
                          Maximum="100"
                          Value="{Binding PlaybackVolume, Mode=TwoWay}" />

                  <TextBlock Grid.Row="3"
                             Text="{DynamicResource ui.tb_prePlay}"
                             ToolTip.Tip="{DynamicResource ui.tooltip.tb_prePlay}"
                             ToolTip.ShowDelay="100"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="3"
                             Grid.Column="1"
                             Text="{Binding PlaybackAdjustSeconds, StringFormat={}{0:F1}s}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                  <Slider Grid.Row="3"
                          Grid.Column="2"
                          Minimum="-4"
                          Maximum="4"
                          Value="{Binding PlaybackAdjustSeconds, Mode=TwoWay}" />

                  <TextBlock Grid.Row="4"
                             Text="{DynamicResource ui.tb_playbackSpd}"
                             ToolTip.Tip="{DynamicResource ui.tooltip.tb_playbackSpd}"
                             ToolTip.ShowDelay="100"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="4"
                             Grid.Column="1"
                             Text="{Binding PlaybackSpeed, StringFormat={}x {0:F2}}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                  <Slider Grid.Row="4"
                          Grid.Column="2"
                          Minimum="0.5"
                          Maximum="1.5"
                          TickFrequency="0.125"
                          IsSnapToTickEnabled="True"
                          Value="{Binding PlaybackSpeed, Mode=TwoWay}" />

                  <TextBlock Grid.Row="5"
                             Text="{DynamicResource settings.factorToRemoveSpaceFromAudioFiles}"
                             ToolTip.Tip="{DynamicResource settings.tooltip.factorToRemoveSpaceFromAudioFiles}"
                             ToolTip.ShowDelay="100"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="5"
                             Grid.Column="1"
                             Text="{Binding SilenceRemovalLevel}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                  <Slider Grid.Row="5"
                          Grid.Column="2"
                          Minimum="0"
                          Maximum="2"
                          TickFrequency="1"
                          IsSnapToTickEnabled="True"
                          Value="{Binding SilenceRemovalLevel, Mode=TwoWay}" />

                  <TextBlock Grid.Row="6"
                             Text="{DynamicResource ui.tb_intercom}"
                             ToolTip.Tip="{DynamicResource ui.tooltip.tb_intercom}"
                             ToolTip.ShowDelay="100"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="6"
                             Grid.Column="1"
                             Text="{Binding IntercomEffect}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                  <Slider Grid.Row="6"
                          Grid.Column="2"
                          Minimum="0"
                          Maximum="100"
                          Value="{Binding IntercomEffect, Mode=TwoWay}" />

                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2"
            Padding="42,10"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="22">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="8" Height="8" Fill="{Binding GameStatusBrush}" />
            <TextBlock Text="{DynamicResource diagnostics.game}" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Text="{Binding GameConnectionStatus}"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="8" Height="8" Fill="{Binding GameStatusBrush}" />
            <TextBlock Text="{DynamicResource diagnostics.udp}" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Text="{Binding StageStatus}"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="8" Height="8" Fill="{Binding AudioStatusBrush}" />
            <TextBlock Text="{DynamicResource diagnostics.audio}" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Text="{Binding AudioStatus}"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="3" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="8" Height="8" Fill="{Binding DashboardStatusBrush}" />
            <TextBlock Text="{DynamicResource settings.tooltip.webDashboardTitle}" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Text="{Binding DashboardStatus}"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
