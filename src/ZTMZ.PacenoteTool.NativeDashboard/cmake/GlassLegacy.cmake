# Included after the backend targets and shared shader compiler are defined.
foreach(api IN ITEMS dx9 dx10)
  if(NOT TARGET ztmz_backend_${api})
    continue()
  endif()
  if(api STREQUAL "dx9")
    set(glass_source "${CMAKE_CURRENT_SOURCE_DIR}/src/graphics/dx9/glass.hlsl")
    set(glass_profile "3_0")
  else()
    set(glass_source "${CMAKE_CURRENT_SOURCE_DIR}/src/graphics/dx11/glass.hlsl")
    set(glass_profile "4_0")
  endif()
  set(legacy_glass_header "${CMAKE_CURRENT_BINARY_DIR}/generated/${api}_glass_shaders.hpp")
  add_custom_command(OUTPUT "${legacy_glass_header}"
    COMMAND $<TARGET_FILE:ztmz_compile_glass_shaders> "${glass_source}" "${legacy_glass_header}" "${glass_profile}"
    DEPENDS ztmz_compile_glass_shaders "${glass_source}" VERBATIM)
  target_sources(ztmz_backend_${api} PRIVATE src/graphics/${api}/glass.cpp "${legacy_glass_header}")
  target_include_directories(ztmz_backend_${api} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
  if(BUILD_TESTING)
    add_executable(${api}_glass_tests tests/legacy_glass_tests.cpp)
    target_link_libraries(${api}_glass_tests PRIVATE ztmz_backend_${api})
    if(api STREQUAL "dx9")
      target_compile_definitions(${api}_glass_tests PRIVATE TEST_DX9)
    endif()
    add_test(NAME ${api}_glass COMMAND ${api}_glass_tests)
    set_tests_properties(${api}_glass PROPERTIES TIMEOUT 60 RUN_SERIAL TRUE)
  endif()
endforeach()
