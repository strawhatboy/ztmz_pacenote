# Emit aligned SPIR-V words rather than casting a byte array to uint32_t.
file(READ "${SOURCE}" source_text)
string(REPLACE "\r\n" "\n" source_text "${source_text}")
string(SHA256 source_hash "${source_text}")
file(WRITE "${OUTPUT}" "// Generated by embed_spirv.cmake; see README.md for regeneration.\n// Source SHA256: ${source_hash}\n#pragma once\n#include <cstdint>\n")
foreach(stage IN ITEMS vs ps)
  file(READ "${${stage}}" bytes HEX)
  string(LENGTH "${bytes}" count)
  math(EXPR last "${count} - 8")
  math(EXPR remainder "${count} % 8")
  if(count LESS 8 OR NOT remainder EQUAL 0)
    message(FATAL_ERROR "Invalid SPIR-V byte count")
  endif()
  file(APPEND "${OUTPUT}" "inline constexpr std::uint32_t vulkan_glass_${stage}[] = {\n")
  foreach(offset RANGE 0 ${last} 8)
    string(SUBSTRING "${bytes}" ${offset} 8 word)
    string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1," word "${word}")
    file(APPEND "${OUTPUT}" "${word}\n")
  endforeach()
  file(APPEND "${OUTPUT}" "};\n")
endforeach()
