<Application x:Class="ZTMZ.PacenoteTool.WpfGUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:ZTMZ.PacenoteTool.WpfGUI"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             DispatcherUnhandledException="OnDispatcherUnhandledException"
            Exit="OnExit"
            Startup="OnStartup"
             >
    <Application.Resources>
         
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/ZTMZ.PacenoteTool.UI.Wpf;component/Res/BaseUi.xaml" />
                <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                    <FontFamily x:Key="SegoeFluentIcons">pack://application:,,,/ZTMZ.PacenoteTool.UI.Wpf;component/Res/#Segoe Fluent Icons</FontFamily>
                    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
                    <system:Double x:Key="AppFontSize">12</system:Double>
                    <system:Double x:Key="AppBodyStrongFontSize">14</system:Double>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
