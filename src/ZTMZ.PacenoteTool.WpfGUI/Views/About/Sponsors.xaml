<UserControl
    x:Class="ZTMZ.PacenoteTool.WpfGUI.Views.About.Sponsors"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="560"
    FontFamily="{DynamicResource AppFontFamily}">
    <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ui:TextBlock
                Margin="0,8,0,4"
                HorizontalAlignment="Center"
                FontTypography="Subtitle"
                Text="{DynamicResource ui.sponsors_major}" />
            <ui:TextBlock
                HorizontalAlignment="Center"
                FontTypography="BodyStrong"
                Text="{Binding MajorSponsor}" />

            <ui:TextBlock
                Margin="0,20,0,4"
                HorizontalAlignment="Center"
                FontTypography="Subtitle"
                Text="{DynamicResource ui.sponsors_supporters}" />
            <ItemsControl ItemsSource="{Binding SponsorNames}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:TextBlock Margin="6,3" Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
