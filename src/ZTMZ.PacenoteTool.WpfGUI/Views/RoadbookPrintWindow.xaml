<ui:ContentDialog x:Class="ZTMZ.PacenoteTool.WpfGUI.Views.RoadbookPrintWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:ZTMZ.PacenoteTool.WpfGUI.Views"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                  DialogWidth="1100"
                  DialogHeight="700"
                  DialogMaxWidth="1120"
                  DialogMaxHeight="720"
                  DialogMargin="20"
                  IsFooterVisible="False"
                  FontFamily="{DynamicResource AppFontFamily}"
                  FontSize="{DynamicResource AppFontSize}"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  Opened="OnOpened"
                  Closed="OnClosed"
                  mc:Ignorable="d">
    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
               TargetType="{x:Type local:RoadbookPrintWindow}" />
    </ui:ContentDialog.Resources>

    <ui:ContentDialog.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Margin="0,0,10,0" Symbol="Print20" VerticalAlignment="Center" />
                <ui:TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </ui:ContentDialog.TitleTemplate>

    <Grid x:Name="PrintLayoutRoot" Width="1040" Height="600">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="680" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="16">
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Background="White">
                    <wv2:WebView2 x:Name="PreviewWebView"
                                  NavigationStarting="PreviewWebView_NavigationStarting"
                                  NavigationCompleted="PreviewWebView_NavigationCompleted" />
                </Border>
                <Border x:Name="PreviewLoading" Background="#CCFFFFFF">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing Width="32" Height="32" IsIndeterminate="True" />
                        <TextBlock x:Name="PreviewStatusText" Margin="0,12,0,0"
                                   Foreground="#FF3A3A3A" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="DestinationLabel" FontWeight="SemiBold" />
                            <ComboBox x:Name="DestinationBox" Margin="0,8,0,18"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="Destination_Changed" />

                            <TextBlock x:Name="LayoutHeading" Margin="0,0,0,10"
                                       FontSize="16" FontWeight="SemiBold" />

                            <TextBlock x:Name="PaperLabel" />
                            <ComboBox x:Name="PaperBox" Margin="0,6,0,14"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="PreviewSetting_Changed" />

                            <TextBlock x:Name="OrientationLabel" />
                            <ComboBox x:Name="OrientationBox" Margin="0,6,0,14"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="PreviewSetting_Changed" />

                            <TextBlock x:Name="MarginsLabel" />
                            <Grid Margin="0,6,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="HorizontalMarginLabel" Margin="0,0,0,4" Opacity="0.72" />
                                    <ui:NumberBox x:Name="HorizontalMarginBox" Minimum="0" Maximum="50"
                                                  SmallChange="1" LargeChange="5" Value="15"
                                                  ValueChanged="PreviewNumberSetting_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="VerticalMarginLabel" Margin="0,0,0,4" Opacity="0.72" />
                                    <ui:NumberBox x:Name="VerticalMarginBox" Minimum="0" Maximum="50"
                                                  SmallChange="1" LargeChange="5" Value="10"
                                                  ValueChanged="PreviewNumberSetting_Changed" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="PageNumbersLabel" />
                            <Grid Margin="0,6,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:ToggleSwitch x:Name="PageNumbersToggle"
                                                 VerticalAlignment="Center"
                                                 IsChecked="True"
                                                 Checked="PageNumberSetting_Changed"
                                                 Unchecked="PageNumberSetting_Changed" />
                                <ComboBox x:Name="PageNumberStyleBox" Grid.Column="2"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="PreviewSetting_Changed" />
                                <ComboBox x:Name="PageNumberPositionBox" Grid.Column="4"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="PreviewSetting_Changed" />
                            </Grid>

                            <TextBlock x:Name="PageRangesLabel" />
                            <TextBox x:Name="PageRangesBox" Margin="0,6,0,4"
                                     TextChanged="PageRanges_Changed" />
                            <TextBlock x:Name="PageRangesHint" Margin="0,0,0,14"
                                       Opacity="0.65" TextWrapping="Wrap" />

                            <StackPanel x:Name="CopiesPanel">
                                <TextBlock x:Name="CopiesLabel" />
                                <ui:NumberBox x:Name="CopiesBox" Width="160" Margin="0,6,0,0"
                                              HorizontalAlignment="Left" Minimum="1" Maximum="99"
                                              SmallChange="1" LargeChange="5" Value="1" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="1" x:Name="CancelButton" Click="Cancel_Click" />
                        <ui:Button Grid.Column="2" x:Name="PrimaryButton" Margin="8,0,0,0"
                                   Appearance="Primary" Click="Primary_Click" />
                    </Grid>
                </Grid>
            </Border>
    </Grid>
</ui:ContentDialog>
