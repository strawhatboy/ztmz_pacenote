<ui:FluentWindow x:Class="ZTMZ.PacenoteTool.WpfGUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZTMZ.PacenoteTool.WpfGUI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
        ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        ExtendsContentIntoTitleBar="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing"
        xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
    FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}"
        Title="{Binding ViewModel.Title, Mode=OneWay}" Height="760" Width="1180" MinWidth="1180" MinHeight="760">
    <b:Interaction.Triggers>
    <b:EventTrigger EventName="Loaded">
        <b:InvokeCommandAction
            CommandParameter="{Binding}"
            Command="{Binding ViewModel.ShowStartupDialogCommand}"/>
    </b:EventTrigger>
    </b:Interaction.Triggers>
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="SearchVisibility" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{Binding ViewModel.Title, Mode=OneWay}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True" HorizontalContentAlignment="Center">
            <ui:TitleBar.Header>
                <TextBlock x:Name="TitleBarLabel" Text="ZTMZ Next Generation Pacenote Tool" FontSize="12" VerticalAlignment="Center"
                           ToolTip="{Binding ViewModel.Title}" ToolTipService.InitialShowDelay="500"
                           shell:WindowChrome.IsHitTestVisibleInChrome="True"
                           MouseLeftButtonDown="OnTitleLabelMouseLeftButtonDown" />
            </ui:TitleBar.Header>
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.CenterContent>
                <Grid Width="360" Margin="12,0" VerticalAlignment="Center"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ui:TextBox x:Name="SettingsSearchBox" MinHeight="32" Padding="8,2" VerticalContentAlignment="Center"
                                Icon="{ui:SymbolIcon Search20}" IconPlacement="Left"
                                PlaceholderText="{DynamicResource settingsSearch.hint}"
                                AutomationProperties.Name="{DynamicResource settingsSearch.title}"
                                Text="{Binding ViewModel.SettingsQuery, UpdateSourceTrigger=PropertyChanged}"
                                TextChanged="OnSettingsSearchChanged" GotKeyboardFocus="OnSettingsSearchFocus"
                                PreviewKeyDown="OnSettingsSearchKeyDown" />
                    <Popup x:Name="SettingsSearchPopup" PlacementTarget="{Binding ElementName=SettingsSearchBox}"
                           Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True"
                           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <Border Width="{Binding PlacementTarget.ActualWidth, ElementName=SettingsSearchPopup}"
                                Padding="4" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource ApplicationBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                PreviewKeyDown="OnSettingsSearchKeyDown">
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Margin="8" TextWrapping="Wrap" Text="{DynamicResource settingsSearch.noResults}"
                                               Visibility="{Binding ViewModel.NoSettingsResults, Converter={StaticResource SearchVisibility}}" />
                                    <ItemsControl x:Name="SettingsSearchResults" ItemsSource="{Binding ViewModel.SettingsResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0 2" Padding="8"
                                                           Command="{Binding DataContext.ViewModel.OpenSettingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding PageTitle}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                </ui:Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ui:TitleBar.CenterContent>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:Button Icon="{ui:SymbolIcon ChatHelp20}" Command="{Binding ViewModel.ShowHelpCommand}"      ToolTip="{DynamicResource ResourceKey=ui.tb_qanda}" FontSize="16"
                    VerticalAlignment="Top"
                    SnapsToDevicePixels="True"
                    Background="Transparent"
                    ToolTipService.InitialShowDelay="100"
                    AutomationProperties.Name="{DynamicResource ResourceKey=ui.tb_qanda}" />
                    <ui:Button Icon="{ui:SymbolIcon Lightbulb20}" Command="{Binding ViewModel.RaiseIssueCommand}" ToolTip="{DynamicResource ResourceKey=ui.raise_issue}"
                    FontSize="16"
                    VerticalAlignment="Top"
                    SnapsToDevicePixels="True"
                    Background="Transparent"
                    ToolTipService.InitialShowDelay="100" AutomationProperties.Name="{DynamicResource ResourceKey=ui.raise_issue}" />
                    <!-- ButtonsForeground="{Binding Path=ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"
                    MouseOverButtonsForeground="{Binding Path=MouseOverButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"
                    MouseOverBackground="{Binding Path=ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"
                    OverridesDefaultStyle="True" -->
                    <ui:Button Icon="{ui:SymbolIcon HeartCircle20}" Foreground="Red"
                    Command="{Binding ViewModel.BuyMeACoffeeCommand}"
                    SnapsToDevicePixels="True"
                    Background="Transparent"
                    FontSize="16"
                    VerticalAlignment="Top"
                    ToolTip="{DynamicResource ResourceKey=ui.donate}"
                    ToolTipService.InitialShowDelay="100"
                    />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>
        <ui:InfoBar Grid.Row="1" Margin="42 0 42 0" IsOpen="{Binding ViewModel.VoiceUpdatesAvailable, Mode=TwoWay}"
                    Severity="Informational" Message="{Binding ViewModel.VoiceUpdatesMessage}">
            <ui:InfoBar.Content>
                <ui:Button Content="{DynamicResource voiceStartup.review}" Command="{Binding ViewModel.ReviewVoiceUpdatesCommand}" />
            </ui:InfoBar.Content>
        </ui:InfoBar>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="2"
            FooterMenuItemsSource="{Binding ViewModel.NavigationFooter, Mode=OneWay}"
            MenuItemsSource="{Binding ViewModel.NavigationItems, Mode=OneWay, diag:PresentationTraceSources.TraceLevel=High}"
            Padding="42,0,42,0"
            BreadcrumbBar="{Binding ElementName=BreadcrumbBar}"
            SelectionChanged="OnNavigationSelectionChanged"
            PaneDisplayMode="LeftFluent">
            
            <ui:NavigationView.Header>
                <StackPanel Margin="42,32,42,20">
                    <ui:BreadcrumbBar x:Name="BreadcrumbBar" />
                </StackPanel>
            </ui:NavigationView.Header>
            <!-- <ui:NavigationView.Header>
                <ui:BreadcrumbBar
                    Margin="42,32,0,0"
                    FontSize="28"
                    FontWeight="DemiBold" />
            </ui:NavigationView.Header> -->
        </ui:NavigationView>

        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.Row="0" Grid.RowSpan="3"/>
    </Grid>
</ui:FluentWindow>
