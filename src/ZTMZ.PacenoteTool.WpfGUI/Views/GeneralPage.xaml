<Page x:Class="ZTMZ.PacenoteTool.WpfGUI.Views.GeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:search="clr-namespace:ZTMZ.PacenoteTool.WpfGUI.Helpers"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ZTMZ.PacenoteTool.WpfGUI.Views"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:system="clr-namespace:System;assembly=System.Runtime"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:localUI="clr-namespace:ZTMZ.PacenoteTool.UI.Windows;assembly=ZTMZ.PacenoteTool.UI.Wpf"
      Title="GeneralPage"
      FontFamily="{DynamicResource AppFontFamily}"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <Page.Resources>
        <x:Array x:Key="AccentColorPresets" Type="{x:Type Color}">
            <Color>#DE9C12</Color>
            <Color>#F7630C</Color>
            <Color>#D13438</Color>
            <Color>#E3008C</Color>
            <Color>#8764B8</Color>
            <Color>#744DA9</Color>
            <Color>#0078D4</Color>
            <Color>#0099BC</Color>
            <Color>#00B7C3</Color>
            <Color>#008272</Color>
            <Color>#107C10</Color>
            <Color>#68768A</Color>
        </x:Array>
        <!-- <Style TargetType="ui:Card">
            <Setter Property="Padding" Value="16"></Setter>
            <Setter Property="Margin" Value="0 0 0 5"></Setter>
        </Style> -->
    </Page.Resources>
    <StackPanel Orientation="Vertical">
        <!-- theme -->
        <ui:Card search:SettingsSearch.Anchor="settings.theme" Margin="0 0 0 3"
                 Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="DarkTheme20"
                                   FontSize="26"
                                   Margin="0 0 10 0"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ui:TextBlock Text="{DynamicResource ResourceKey=settings.theme}"/>
                        <ui:TextBlock Grid.Row="1"
                                      Text="{DynamicResource ResourceKey=settings.tooltip.theme}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      FontTypography="Caption"/>
                    </Grid>
                </StackPanel>
                <ComboBox Grid.Column="1"
                          SelectedIndex="{Binding Path=ViewModel.ThemeSelection, Mode=TwoWay}">
                    <ComboBox.Items>
                        <ComboBoxItem Content="{DynamicResource ResourceKey=settings.lightTheme}"/>
                        <ComboBoxItem Content="{DynamicResource ResourceKey=settings.darkTheme}"/>
                        <ComboBoxItem Content="{DynamicResource ResourceKey=settings.systemTheme}"/>
                    </ComboBox.Items>
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction
                                CommandParameter="{Binding}"
                                Command="{Binding ViewModel.ThemeSelectionChangedCommand}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ComboBox>
            </Grid>
        </ui:Card>

        <!-- application font -->
        <ui:Card search:SettingsSearch.Anchor="font.systemFont" Margin="0 0 0 3"
                 Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="LocalLanguage20"
                                   FontSize="26"
                                   Margin="0 0 10 0"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ui:TextBlock Text="{DynamicResource ResourceKey=font.systemFont}"/>
                        <ui:TextBlock Grid.Row="1"
                                      Text="{DynamicResource ResourceKey=font.systemFontDescription}"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      FontTypography="Caption"/>
                    </Grid>
                </StackPanel>
                <ComboBox Grid.Column="1"
                          DisplayMemberPath="DisplayName"
                          IsTextSearchEnabled="True"
                          ItemsSource="{Binding Path=ViewModel.SystemFonts, Mode=OneWay}"
                          SelectedItem="{Binding Path=ViewModel.SelectedSystemFont, Mode=TwoWay}"/>
            </Grid>
        </ui:Card>

        <!-- application font size -->
        <ui:Card search:SettingsSearch.Anchor="font.size" Margin="0 0 0 3"
                 Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="TextFontSize20"
                                   FontSize="26"
                                   Margin="0 0 10 0"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ui:TextBlock Text="{DynamicResource ResourceKey=font.size}"/>
                        <ui:TextBlock Grid.Row="1"
                                      Text="{DynamicResource ResourceKey=font.sizeDescription}"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      FontTypography="Caption"/>
                    </Grid>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="85"
                            Maximum="130"
                            TickFrequency="5"
                            IsSnapToTickEnabled="True"
                            SmallChange="5"
                            LargeChange="10"
                            Value="{Binding Path=ViewModel.UiFontSizePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <ui:TextBlock Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Text="{Binding Path=ViewModel.UiFontSizePercent, StringFormat={}{0}%}"/>
                    <ui:Button Grid.Column="2"
                               Margin="8 0 0 0"
                               Command="{Binding ViewModel.ResetUiFontSizeCommand}"
                               Icon="{ui:SymbolIcon ArrowReset20}"
                               ToolTip="{DynamicResource ResourceKey=font.resetSize}"/>
                </Grid>
            </Grid>
        </ui:Card>

        <!-- suggested downloadable font -->
        <ui:Card search:SettingsSearch.Anchor="font.suggestedFont" Margin="0 0 0 3"
                 Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowDownload20"
                                   FontSize="26"
                                   Margin="0 0 10 0"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ui:TextBlock Text="{DynamicResource ResourceKey=font.suggestedFont}"/>
                        <ui:TextBlock Grid.Row="1"
                                      Text="{Binding Path=ViewModel.SuggestedFontStatus, Mode=OneWay}"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      FontTypography="Caption"/>
                    </Grid>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox IsTextSearchEnabled="True"
                              ItemsSource="{Binding Path=ViewModel.SuggestedFonts, Mode=OneWay}"
                              SelectedItem="{Binding Path=ViewModel.SelectedSuggestedFont, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           ToolTip="{Binding Description}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ui:Button Grid.Column="1"
                               Margin="8 0 0 0"
                               Command="{Binding ViewModel.InstallSuggestedFontCommand}"
                               Content="{Binding Path=ViewModel.SuggestedFontActionText, Mode=OneWay}"/>
                    <ui:Button Grid.Column="2"
                               Margin="8 0 0 0"
                               Command="{Binding ViewModel.RefreshSuggestedFontCatalogCommand}"
                               Icon="{ui:SymbolIcon ArrowClockwise20}"
                               ToolTip="{DynamicResource ResourceKey=font.refreshCatalog}"/>
                </Grid>
                <ProgressBar Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Margin="0 12 0 0"
                             Minimum="0"
                             Maximum="1"
                             Value="{Binding Path=ViewModel.SuggestedFontDownloadProgress, Mode=OneWay}"
                             Visibility="{Binding Path=ViewModel.IsDownloadingSuggestedFont, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </ui:Card>
        <!-- accent color -->
        <ui:Card search:SettingsSearch.Anchor="settings.accentColor" Margin="0 0 0 3"
                 Visibility="{Binding Path=ViewModel.AccentColorPickerVisibility, Mode=OneWay}"
                 Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Color20"
                                       FontSize="26"
                                       Margin="0 0 10 0"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <ui:TextBlock Text="{DynamicResource ResourceKey=settings.accentColor}"/>
                            <ui:TextBlock Grid.Row="1"
                                          Text="{DynamicResource ResourceKey=settings.tooltip.accentColor}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          FontTypography="Caption"/>
                        </Grid>
                    </StackPanel>
                    <Grid Grid.Column="1">
                        <ToggleButton x:Name="AccentColorButton" Padding="4" MinHeight="36"
                                      HorizontalContentAlignment="Stretch"
                                      ToolTip="{DynamicResource settings.accentColor}"
                                      AutomationProperties.Name="{DynamicResource settings.accentColor}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Background="{Binding ViewModel.AccentColor}" CornerRadius="3" MinHeight="24" />
                                <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown20" FontSize="16" Margin="8,0,4,0" />
                            </Grid>
                        </ToggleButton>
                        <Popup x:Name="AccentColorPopup" PlacementTarget="{Binding ElementName=AccentColorButton}"
                               Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding IsChecked, ElementName=AccentColorButton, Mode=TwoWay}"
                               PreviewKeyDown="OnAccentColorPopupKeyDown">
                            <Border Background="{DynamicResource ApplicationBackgroundBrush}" Padding="8"
                                    CornerRadius="6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <ItemsControl ItemsSource="{StaticResource AccentColorPresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button Width="36" Height="36" Margin="2" Padding="3"
                                                       Tag="{Binding}" ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                                                       Click="OnAccentColorPresetClick">
                                                <Border Width="28" Height="28" CornerRadius="3">
                                                    <Border.Background><SolidColorBrush Color="{Binding}" /></Border.Background>
                                                </Border>
                                            </ui:Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
                <Border Grid.Row="1"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                        Background="Transparent">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Column="1"
                                      Text="{DynamicResource ResourceKey=settings.accentColorR}"/>
                        <ui:TextBlock Grid.Column="1"
                                      Grid.Row="1"
                                      Text="{DynamicResource ResourceKey=settings.accentColorG}"/>
                        <ui:TextBlock Grid.Column="1"
                                      Grid.Row="2"
                                      Text="{DynamicResource ResourceKey=settings.accentColorB}"/>
                        <ui:TextBlock Grid.Row="0"
                                      Grid.Column="2"
                                      Text="{Binding Path=ViewModel.AccentColorR, Mode=OneWay}"/>
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="2"
                                      Text="{Binding Path=ViewModel.AccentColorG, Mode=OneWay}"/>
                        <ui:TextBlock Grid.Row="2"
                                      Grid.Column="2"
                                      Text="{Binding Path=ViewModel.AccentColorB, Mode=OneWay}"/>

                        <Slider Grid.Row="0"
                                Grid.Column="3"
                                Maximum="255"
                                Minimum="0"
                                Interval="1"
                                Value="{Binding Path=ViewModel.AccentColorR, Mode=TwoWay}"/>
                        <Slider Grid.Row="1"
                                Grid.Column="3"
                                Maximum="255"
                                Minimum="0"
                                Interval="1"
                                Value="{Binding Path=ViewModel.AccentColorG, Mode=TwoWay}"/>
                        <Slider Grid.Row="2"
                                Grid.Column="3"
                                Maximum="255"
                                Minimum="0"
                                Interval="1"
                                Value="{Binding Path=ViewModel.AccentColorB, Mode=TwoWay}"/>
                    </Grid>
                </Border>
            </Grid>
        </ui:Card>

        <!-- language -->
        <ui:Card search:SettingsSearch.Anchor="settings.language" Margin="0 0 0 3"
                 Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="LocalLanguage20"
                                   FontSize="26"
                                   Margin="0 0 10 0"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ui:TextBlock Text="{DynamicResource ResourceKey=settings.language}"/>
                        <ui:TextBlock Grid.Row="1"
                                      Text="{DynamicResource ResourceKey=settings.tooltip.language}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      FontTypography="Caption"/>
                    </Grid>
                </StackPanel>
                <ComboBox Grid.Column="1"
                          SelectedIndex="{Binding Path=ViewModel.LanguageSelection, Mode=TwoWay}"
                          ItemsSource="{Binding Path=ViewModel.Languages, Mode=OneWay}">
                </ComboBox>
            </Grid>
        </ui:Card>

        <!-- startup check update -->
        <ui:Card search:SettingsSearch.Anchor="settings.checkUpdateWhenStartup" Margin="0 0 0 3"
                 Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="PhoneUpdate20"
                                   FontSize="26"
                                   Margin="0 0 10 0"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ui:TextBlock Text="{DynamicResource ResourceKey=settings.checkUpdateWhenStartup}"/>
                        <ui:TextBlock Grid.Row="1"
                                      Text="{DynamicResource ResourceKey=settings.tooltip.checkUpdateWhenStartup}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      FontTypography="Caption"/>
                    </Grid>
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1"
                                 HorizontalAlignment="Right"
                                 IsChecked="{Binding Path=ViewModel.IsAutoUpdate, Mode=TwoWay}"/>
            </Grid>
        </ui:Card>

        <!-- startWithSystem -->
        <ui:Card search:SettingsSearch.Anchor="settings.startWithSystem" Margin="0 0 0 3"
                 Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="PersonRunning20"
                                   FontSize="26"
                                   Margin="0 0 10 0"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ui:TextBlock Text="{DynamicResource ResourceKey=settings.startWithSystem}"/>
                        <ui:TextBlock Grid.Row="1"
                                      Text="{DynamicResource ResourceKey=settings.tooltip.startWithSystem}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      FontTypography="Caption"/>
                    </Grid>
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1"
                                 HorizontalAlignment="Right"
                                 IsChecked="{Binding Path=ViewModel.IsStartWithWindows, Mode=TwoWay}"/>
            </Grid>
        </ui:Card>

        <!-- <localUI:CommonSettingsItem Icon="{ui:SymbolIcon PersonRunning20}" Label="{DynamicResource ResourceKey=settings.startWithSystem}"
            Description="{DynamicResource ResourceKey=settings.tooltip.startWithSystem}" SettingsPropertyName="StartWithWindows" /> -->

        <!-- start minimized to tray -->
        <ui:Card search:SettingsSearch.Anchor="settings.startMinimizedToTray" Margin="0 0 0 3"
                 Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowMinimize20"
                                   FontSize="26"
                                   Margin="0 0 10 0"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ui:TextBlock Text="{DynamicResource ResourceKey=settings.startMinimizedToTray}"/>
                        <ui:TextBlock Grid.Row="1"
                                      Text="{DynamicResource ResourceKey=settings.tooltip.startMinimizedToTray}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      FontTypography="Caption"/>
                    </Grid>
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1"
                                 HorizontalAlignment="Right"
                                 IsChecked="{Binding Path=ViewModel.IsStartMinimizedToTray, Mode=TwoWay}"/>
            </Grid>
        </ui:Card>

        <!-- Windows event notifications -->
        <ui:Card search:SettingsSearch.Anchor="settings.windowsNotifications" Margin="0 0 0 3"
                 Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Alert20"
                                   FontSize="26"
                                   Margin="0 0 10 0"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ui:TextBlock Text="{DynamicResource ResourceKey=settings.windowsNotifications}"/>
                        <ui:TextBlock Grid.Row="1"
                                      Text="{DynamicResource ResourceKey=settings.tooltip.windowsNotifications}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      FontTypography="Caption"/>
                    </Grid>
                </StackPanel>
                <Grid Grid.Column="1">
                    <ui:Button Icon="{ui:SymbolIcon Play20}"
                               Command="{Binding ViewModel.SendTestWindowsNotificationCommand}"
                               HorizontalAlignment="Left"
                               ToolTip="{DynamicResource ResourceKey=settings.testWindowsNotification}"
                               ToolTipService.InitialShowDelay="100"/>
                    <ui:ToggleSwitch HorizontalAlignment="Right"
                                     IsChecked="{Binding Path=ViewModel.IsWindowsNotificationsEnabled, Mode=TwoWay}"/>
                </Grid>
            </Grid>
        </ui:Card>

        <!-- OptInBetaPlan -->
        <ui:Card search:SettingsSearch.Anchor="settings.optInBetaPlan" Margin="0 0 0 3"
                 Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="New20"
                                   FontSize="26"
                                   Margin="0 0 10 0"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ui:TextBlock Text="{DynamicResource ResourceKey=settings.optInBetaPlan}"/>
                        <ui:TextBlock Grid.Row="1"
                                      Text="{DynamicResource ResourceKey=settings.tooltip.optInBetaPlan}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      FontTypography="Caption"/>
                    </Grid>
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1"
                                 HorizontalAlignment="Right"
                                 IsChecked="{Binding Path=ViewModel.IsOptInBetaPlan, Mode=TwoWay}"/>
            </Grid>
        </ui:Card>

        <!-- LogLevel -->
        <ui:Card search:SettingsSearch.Anchor="settings.logLevel" Margin="0 0 0 3"
                 Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="MailError20"
                                   FontSize="26"
                                   Margin="0 0 10 0"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ui:TextBlock Text="{DynamicResource ResourceKey=settings.logLevel}"/>
                        <ui:TextBlock Grid.Row="1"
                                      Text="{DynamicResource ResourceKey=settings.tooltip.logLevel}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      FontTypography="Caption"/>
                    </Grid>
                </StackPanel>
                <ui:Button Icon="{ui:SymbolIcon FolderMail20}"
                           Grid.Column="1"
                           Command="{Binding ViewModel.ViewLogsCommand}"
                           Content="{DynamicResource ResourceKey=settings.tooltip.viewLogs}"
                           Margin="0 0 10 0"/>
                <ComboBox Grid.Column="2"
                          SelectedIndex="{Binding Path=ViewModel.LogLevel, Mode=TwoWay}">
                    <ComboBox.Items>
                        <ComboBoxItem Content="{DynamicResource ResourceKey=logLevel.trace}"/>
                        <ComboBoxItem Content="{DynamicResource ResourceKey=logLevel.debug}"/>
                        <ComboBoxItem Content="{DynamicResource ResourceKey=logLevel.info}"/>
                        <ComboBoxItem Content="{DynamicResource ResourceKey=logLevel.warn}"/>
                        <ComboBoxItem Content="{DynamicResource ResourceKey=logLevel.error}"/>
                        <ComboBoxItem Content="{DynamicResource ResourceKey=logLevel.fatal}"/>
                        <ComboBoxItem Content="{DynamicResource ResourceKey=logLevel.off}"/>
                    </ComboBox.Items>
                </ComboBox>
            </Grid>
        </ui:Card>

        <!-- show close behavior dialog -->
        <ui:Card search:SettingsSearch.Anchor="ui.showClosePrompt" Margin="0 0 0 3"
                 Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Stop20"
                                   FontSize="26"
                                   Margin="0 0 10 0"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ui:TextBlock Text="{DynamicResource ResourceKey=ui.showClosePrompt}"/>
                        <ui:TextBlock Grid.Row="1"
                                      Text="{DynamicResource ResourceKey=ui.tooltip.showClosePrompt}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      FontTypography="Caption"/>
                    </Grid>
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1"
                                 HorizontalAlignment="Right"
                                 IsChecked="{Binding Path=ViewModel.ShowClosePrompt, Mode=TwoWay}"/>
            </Grid>
        </ui:Card>

        <!-- close button behavior -->
        <ui:Card search:SettingsSearch.Anchor="ui.closeBehavior" Margin="0 0 0 3"
                 Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ShareScreenStop20"
                                   FontSize="26"
                                   Margin="0 0 10 0"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ui:TextBlock Text="{DynamicResource ResourceKey=ui.closeBehavior}"/>
                        <ui:TextBlock Grid.Row="1"
                                      Text="{DynamicResource ResourceKey=ui.tooltip.closeBehavior}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      FontTypography="Caption"/>
                    </Grid>
                </StackPanel>
                <ComboBox Grid.Column="1"
                          SelectedIndex="{Binding Path=ViewModel.CloseBehaviorSelection, Mode=TwoWay}">
                    <ComboBox.Items>
                        <ComboBoxItem Content="{DynamicResource ResourceKey=ui.closeToExit}"
                                ToolTip="{DynamicResource ResourceKey=ui.tooltip.closeToExit}"
                                ToolTipService.InitialShowDelay="100"/>
                        <ComboBoxItem Content="{DynamicResource ResourceKey=ui.closeToMinimize}"
                                ToolTip="{DynamicResource ResourceKey=ui.tooltip.closeToMinimize}"
                                ToolTipService.InitialShowDelay="100"/>
                    </ComboBox.Items>
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction
                                CommandParameter="{Binding}"
                                Command="{Binding ViewModel.CloseBehaviorSelectionChangedCommand}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ComboBox>
            </Grid>
        </ui:Card>
    </StackPanel>
</Page>
