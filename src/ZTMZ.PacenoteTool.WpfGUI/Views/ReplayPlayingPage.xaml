<Page x:Class="ZTMZ.PacenoteTool.WpfGUI.Views.ReplayPlayingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:controls="clr-namespace:ZTMZ.PacenoteTool.WpfGUI.Controls"
      xmlns:helper="clr-namespace:ZTMZ.PacenoteTool.WpfGUI.Helpers"
      Title="ReplayPlayingPage"
      FontFamily="pack://application:,,,/fonts/#Noto Sans SC"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ui:NavigationView.HeaderContent="{Binding ViewModel.HeaderContent}"
      mc:Ignorable="d">
  <Page.InputBindings>
    <KeyBinding Key="Space" Command="{Binding ViewModel.SpaceKeyCommand}" />
    <KeyBinding Key="Left" Command="{Binding ViewModel.LeftKeyCommand}" />
    <KeyBinding Key="Right" Command="{Binding ViewModel.RightKeyCommand}" />
  </Page.InputBindings>

  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <helper:BooleanToVisibilityConverterFalse x:Key="BooleanToVisibilityConverterFalse" />
    <Style x:Key="TelemetryLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="TelemetryValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Page.Resources>

  <Grid Margin="0 4 0 0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="0 0 0 12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding ViewModel.Track}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding ViewModel.Car}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding ViewModel.CarClass}" Margin="0 0 14 0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        <ui:ToggleSwitch Content="{DynamicResource settings.replayLock}"
                         IsChecked="{Binding ViewModel.ReplayLocked, Mode=TwoWay}" />
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="1" SelectedIndex="{Binding ViewModel.SelectedViewIndex, Mode=TwoWay}">
      <TabItem Header="{DynamicResource replay.playback}">
        <Grid Margin="0 12 0 0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="320" />
            <ColumnDefinition Width="*" MinWidth="230" />
          </Grid.ColumnDefinitions>

          <Grid Grid.Row="0" Grid.Column="0" Margin="0 0 16 0" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Image Source="pack://application:,,,/ZTMZ.PacenoteTool.Base.UI;component/unknown_dashboard_preview_image.png"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />
            <MediaElement x:Name="videoPlayer"
                          Stretch="Uniform"
                          Source="{Binding ViewModel.VideoPath}"
                          Volume="{Binding ViewModel.Volume}"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          ScrubbingEnabled="{Binding ViewModel.ScrubbingEnabled}" />
          </Grid>

          <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{DynamicResource replay.liveTelemetry}" FontWeight="SemiBold" Margin="0 0 0 10" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource replay.elapsed}" Style="{StaticResource TelemetryLabel}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ViewModel.LapTime, StringFormat={}{0:0.000}}" Style="{StaticResource TelemetryValue}" HorizontalAlignment="Right" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource replay.distance}" Style="{StaticResource TelemetryLabel}" Margin="0 8 0 0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ViewModel.LapDistance, StringFormat={}{0:0} m}" Style="{StaticResource TelemetryValue}" HorizontalAlignment="Right" Margin="0 8 0 0" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource dashboard.speed}" Style="{StaticResource TelemetryLabel}" Margin="0 8 0 0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ViewModel.CurrentSpeed, StringFormat={}{0:0} km/h}" Style="{StaticResource TelemetryValue}" HorizontalAlignment="Right" Margin="0 8 0 0" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource dashboard.gear}" Style="{StaticResource TelemetryLabel}" Margin="0 8 0 0" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ViewModel.CurrentGear, StringFormat={}{0:0}}" Style="{StaticResource TelemetryValue}" HorizontalAlignment="Right" Margin="0 8 0 0" />

            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0 18 0 0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource dashboard.throttle}" Style="{StaticResource TelemetryLabel}" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Margin="10 0" Height="8" Minimum="0" Maximum="100" Value="{Binding ViewModel.CurrentThrottlePercent}" />
                <TextBlock Grid.Column="2" Text="{Binding ViewModel.CurrentThrottlePercent, StringFormat={}{0:0}%}" Style="{StaticResource TelemetryLabel}" />
              </Grid>
              <Grid Margin="0 8 0 0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource dashboard.brake}" Style="{StaticResource TelemetryLabel}" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Margin="10 0" Height="8" Minimum="0" Maximum="100" Value="{Binding ViewModel.CurrentBrakePercent}" />
                <TextBlock Grid.Column="2" Text="{Binding ViewModel.CurrentBrakePercent, StringFormat={}{0:0}%}" Style="{StaticResource TelemetryLabel}" />
              </Grid>
            </StackPanel>

            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="0 20 0 0">
              <TextBlock Text="{DynamicResource settings.replayGotoLapDistance}" Style="{StaticResource TelemetryLabel}" />
              <TextBox Text="{Binding ViewModel.GotoLapDistance, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                       Margin="0 4 0 0"
                       HorizontalContentAlignment="Right" />
              <Grid Margin="0 12 0 0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource replay.finishTime}" Style="{StaticResource TelemetryLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.FinishTime, StringFormat={}{0:0.000}}" Style="{StaticResource TelemetryLabel}" />
              </Grid>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0 18 0 0">
            <TextBlock Text="{DynamicResource replay.runOverview}" FontWeight="SemiBold" Margin="0 0 0 6" />
            <controls:ReplayOverviewControl Height="112"
                                            ThrottlePoints="{Binding ViewModel.OverviewThrottlePoints}"
                                            BrakePoints="{Binding ViewModel.OverviewBrakePoints}"
                                            SpeedPoints="{Binding ViewModel.OverviewSpeedPoints}"
                                            CursorDistance="{Binding ViewModel.OverviewCursorDistance}"
                                            MaximumDistance="{Binding ViewModel.OverviewMaximumDistance}" />
          </StackPanel>

          <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0 18 0 0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <ui:Button Width="32" Height="32" Padding="0" Command="{Binding ViewModel.SpaceKeyCommand}" ToolTip="{DynamicResource settings.play}">
              <ui:Button.Icon>
                <ui:SymbolIcon>
                  <ui:SymbolIcon.Style>
                    <Style TargetType="ui:SymbolIcon">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.IsPaused}" Value="True">
                          <Setter Property="Symbol" Value="Play20" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ViewModel.IsPaused}" Value="False">
                          <Setter Property="Symbol" Value="Pause20" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
              </ui:Button.Icon>
            </ui:Button>
            <Slider x:Name="sl_video"
                    Grid.Column="1"
                    Margin="12 0"
                    Minimum="0"
                    Maximum="{Binding ViewModel.VideoLength}"
                    Value="{Binding ViewModel.PlayPosition, Mode=TwoWay}"
                    Thumb.DragStarted="thumb_DragStarted"
                    Thumb.DragCompleted="thumb_DragCompleted"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{DynamicResource replay.volume}" VerticalAlignment="Center" Margin="0 0 8 0" />
            <Slider Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding ViewModel.Volume, Mode=TwoWay}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="{DynamicResource replay.speed}" VerticalAlignment="Center" Margin="16 0 8 0" />
            <Slider Grid.Column="5" Minimum="0.1" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding ViewModel.PlaySpeed, Mode=TwoWay}" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource replay.analysis}">
        <Grid Margin="0 12 0 0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding ViewModel.AnalysisMetrics}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding ViewModel.SelectedAnalysisMetric, Mode=TwoWay}"
                      VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{DynamicResource replay.analysisDistanceHint}" Margin="14 0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <ui:ToggleSwitch Grid.Column="2"
                             Content="{DynamicResource replay.compareBest}"
                             Visibility="{Binding ViewModel.HasBestReplay, Converter={StaticResource BooleanToVisibilityConverter}}"
                             IsChecked="{Binding ViewModel.ShowBestReplayComparison, Mode=TwoWay}" />
          </Grid>
          <lvc:CartesianChart Grid.Row="1"
                              Series="{Binding ViewModel.AnalysisSeries}"
                              XAxes="{Binding ViewModel.AnalysisXAxis}"
                              YAxes="{Binding ViewModel.AnalysisYAxis}"
                              EasingFunction="{x:Null}"
                              AnimationsSpeed="00:00:00"
                              ZoomMode="X" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Page>
