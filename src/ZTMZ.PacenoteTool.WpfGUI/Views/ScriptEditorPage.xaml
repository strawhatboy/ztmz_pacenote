<Page x:Class="ZTMZ.PacenoteTool.WpfGUI.Views.ScriptEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      FontFamily="{DynamicResource AppFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Loaded="OnLoaded"
      mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Icon="{ui:SymbolIcon FolderOpen20}" Click="Open_Click"
                       ToolTip="{DynamicResource ResourceKey=scriptEditor.open}" />
            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Save20}" Click="Save_Click"
                       ToolTip="{DynamicResource ResourceKey=scriptEditor.save}" />
            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon SaveCopy20}" Click="SaveAs_Click"
                       ToolTip="{DynamicResource ResourceKey=scriptEditor.saveAs}" />
            <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon ArrowImport20}" Click="Import_Click"
                       ToolTip="{DynamicResource ResourceKey=scriptEditor.importCrewChief}" />
            <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon ArrowClockwise20}" Click="Validate_Click"
                       ToolTip="{DynamicResource ResourceKey=scriptEditor.validate}" />
            <ui:Button Grid.Column="5" Icon="{ui:SymbolIcon Print20}" Click="PrintRoadbook_Click"
                       ToolTip="{DynamicResource ResourceKey=scriptEditor.printRoadbook}" />
            <ui:ToggleSwitch Grid.Column="6" Margin="12,0,0,0" IsChecked="True"
                             Checked="WordWrap_Changed" Unchecked="WordWrap_Changed"
                             Content="{DynamicResource ResourceKey=scriptEditor.wordWrap}" />
            <ui:TextBlock Grid.Column="8" VerticalAlignment="Center"
                          Text="{DynamicResource ResourceKey=scriptEditor.adjustDistance}" />
            <ui:NumberBox Grid.Column="9" x:Name="DistanceAdjustment" Width="160" Margin="8,0,8,0" Value="0" />
            <ui:Button Grid.Column="10" Icon="{ui:SymbolIcon ArrowSync20}" Click="AdjustDistance_Click"
                       ToolTip="{DynamicResource ResourceKey=scriptEditor.adjustDistance}" />
            <TextBlock Grid.Column="11" x:Name="StatusText" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>

        <ContentControl x:Name="EditorHost" Grid.Row="1" />

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                          Text="{DynamicResource ResourceKey=scriptEditor.roadbookScale}" />
            <Slider Grid.Column="1" x:Name="RoadbookScale" Minimum="50" Maximum="200" Value="100"
                    TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="20"
                    ValueChanged="RoadbookScale_ValueChanged"
                    ToolTip="{DynamicResource ResourceKey=scriptEditor.roadbookScaleDescription}" />
            <ui:TextBlock Grid.Column="2" x:Name="RoadbookScaleValue" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Text="100%" />
        </Grid>
    </Grid>
</Page>
