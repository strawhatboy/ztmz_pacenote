<UserControl
    x:Class="ZTMZ.PacenoteTool.WpfGUI.Views.DiagnosticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    FontFamily="pack://application:,,,/fonts/#Noto Sans SC"
    MinWidth="720"
    MaxWidth="820">
    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Text="{Binding ViewModel.CapturedAt}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                              VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon ArrowClockwise20}"
                               Content="{DynamicResource diagnostics.refresh}"
                               Command="{Binding ViewModel.RefreshCommand}"
                               Margin="0,0,6,0" />
                    <ui:Button Icon="{ui:SymbolIcon FolderMail20}"
                               Content="{DynamicResource diagnostics.createBundle}"
                               Command="{Binding ViewModel.CreateSupportBundleCommand}" />
                </StackPanel>
            </Grid>

            <ui:Card Margin="0,0,0,6" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:TextBlock Text="{DynamicResource diagnostics.application}" FontTypography="BodyStrong" />
                    <ui:TextBlock Grid.Column="1" Text="{Binding ViewModel.ApplicationStatus}" TextWrapping="Wrap" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,6" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ui:TextBlock Text="{DynamicResource diagnostics.game}" FontTypography="BodyStrong" />
                    <ui:TextBlock Grid.Column="1" Text="{Binding ViewModel.GameStatus}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Text="{DynamicResource diagnostics.prerequisite}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ViewModel.PrerequisiteStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,6" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ui:TextBlock Text="{DynamicResource diagnostics.udp}" FontTypography="BodyStrong" />
                    <ui:TextBlock Grid.Column="1" Text="{Binding ViewModel.UdpStatus}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Text="{DynamicResource diagnostics.activity}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ViewModel.UdpActivity}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,6" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ui:TextBlock Text="{DynamicResource diagnostics.audio}" FontTypography="BodyStrong" />
                    <ui:TextBlock Grid.Column="1" Text="{Binding ViewModel.AudioStatus}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Text="{DynamicResource diagnostics.activity}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ViewModel.AudioActivity}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,6" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ui:TextBlock Text="{DynamicResource diagnostics.webDashboard}" FontTypography="BodyStrong" />
                    <ui:TextBlock Grid.Column="1" Text="{Binding ViewModel.WebDashboardStatus}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Text="{DynamicResource diagnostics.activity}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ViewModel.WebDashboardActivity}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
            </ui:Card>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ui:TextBlock Text="{Binding ViewModel.BundleStatus}"
                              Foreground="{Binding ViewModel.BundleStatusBrush}"
                              TextWrapping="Wrap"
                              VerticalAlignment="Center" />
                <ui:Button Grid.Column="1"
                           Icon="{ui:SymbolIcon AppFolder20}"
                           Content="{DynamicResource diagnostics.openSupportFolder}"
                           Command="{Binding ViewModel.OpenSupportFolderCommand}"
                           IsEnabled="{Binding ViewModel.HasBundle}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
