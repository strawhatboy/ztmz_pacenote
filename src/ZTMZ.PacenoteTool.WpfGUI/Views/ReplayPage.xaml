<Page x:Class="ZTMZ.PacenoteTool.WpfGUI.Views.ReplayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ZTMZ.PacenoteTool.WpfGUI.Views"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helper="clr-namespace:ZTMZ.PacenoteTool.WpfGUI.Helpers"
      Title="ReplayPage"
    FontFamily="{DynamicResource AppFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <helper:BooleanToVisibilityConverterFalse x:Key="BooleanToVisibilityConverterFalse" />
    <Style x:Key="CenteredCell" TargetType="DataGridCell">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="ReplayStatus" TargetType="TextBlock">
      <Setter Property="Text" Value="{DynamicResource replay.unavailable}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Available}" Value="True">
          <Setter Property="Text" Value="{DynamicResource replay.ready}" />
          <Setter Property="Foreground" Value="Green" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="0 0 0 12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{DynamicResource replay.title}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
          <Run Text="{DynamicResource replay.browserSubtitle}" />
          <Run Text=": " />
          <Run Text="{Binding ViewModel.CurrentGameName}" FontWeight="SemiBold" />
        </TextBlock>
        <ProgressBar Height="3" Margin="0 6 12 0" IsIndeterminate="True"
                     Visibility="{Binding ViewModel.ReplayExportMotecCommand.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </StackPanel>
      <TextBox Grid.Column="1"
               Text="{Binding ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="{DynamicResource replay.searchTooltip}"
               VerticalContentAlignment="Center" />
      <ui:Button Grid.Column="2"
                 Margin="10 0 0 0"
                 MinWidth="132"
                 Height="36"
                 Padding="12 0"
                 Appearance="Secondary"
                 FontWeight="SemiBold"
                 Icon="{ui:SymbolIcon Settings20}"
                 Content="{DynamicResource settings.subsection.replay}"
                 ToolTip="{DynamicResource settings.subsection.tooltip.replay}"
                 Command="{Binding ViewModel.NavigateForwardCommand}"
                 CommandParameter="{x:Type local:ReplaySettingsPage}" />
    </Grid>

    <DataGrid Grid.Row="1"
              ItemsSource="{Binding ViewModel.ReplaysView}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserSortColumns="True"
              CanUserReorderColumns="True"
              HeadersVisibility="Column"
              CellStyle="{StaticResource CenteredCell}"
              EnableRowVirtualization="True"
              EnableColumnVirtualization="True"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="{DynamicResource replay.status}" Width="90" SortMemberPath="Available">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource ReplayStatus}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{DynamicResource replay.stage}" Binding="{Binding Track}" Width="2*" MinWidth="170" />
        <DataGridTextColumn Header="{DynamicResource replay.car}" Binding="{Binding Car}" Width="*" MinWidth="130" />
        <DataGridTextColumn Header="{DynamicResource replay.class}" Binding="{Binding Car_class}" Width="*" MinWidth="110" />
        <DataGridTextColumn Header="{DynamicResource replay.finishTime}" Binding="{Binding FinishTimeDisplay}" Width="110" SortMemberPath="Finish_time" />
        <DataGridTextColumn Header="{DynamicResource replay.recorded}" Binding="{Binding RecordedDisplay}" Width="145" SortMemberPath="Date" />
        <DataGridTextColumn Header="{DynamicResource replay.note}" Binding="{Binding Comment}" Width="*" MinWidth="150" />
        <DataGridTemplateColumn Header="{DynamicResource replay.actions}" Width="210" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" MinWidth="135">
                <ui:Button Margin="0 0 5 0"
                           Padding="0"
                           Width="30"
                           Height="30"
                           Foreground="Green"
                           Icon="{ui:SymbolIcon Play20}"
                           ToolTip="{DynamicResource settings.play}"
                           IsEnabled="{Binding Available}"
                           CommandParameter="{Binding Id}"
                           Command="{Binding ViewModel.ReplayPlayCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                <ui:Button Margin="0 0 5 0"
                           Padding="0"
                           Width="30"
                           Height="30"
                           Icon="{ui:SymbolIcon Share20}"
                           ToolTip="{DynamicResource settings.replayExport}"
                           IsEnabled="{Binding Available}"
                           CommandParameter="{Binding Id}"
                           Command="{Binding ViewModel.ReplayExportCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                <ui:Button Margin="0 0 5 0"
                           Padding="0"
                           Width="30"
                           Height="30"
                           Icon="{ui:SymbolIcon SoundSource20}"
                           ToolTip="{DynamicResource settings.replayExportAudio}"
                           IsEnabled="{Binding Available}"
                           CommandParameter="{Binding Id}"
                           Command="{Binding ViewModel.ReplayExportAudioCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                <ui:Button Margin="0 0 5 0"
                           Padding="0"
                           Width="30"
                           Height="30"
                           Icon="{ui:SymbolIcon Save20}"
                           ToolTip="{DynamicResource settings.replayExportMotec}"
                           IsEnabled="{Binding Available}"
                           CommandParameter="{Binding Id}"
                           Command="{Binding ViewModel.ReplayExportMotecCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                <ui:Button Padding="0"
                           Width="30"
                           Height="30"
                           Visibility="{Binding Locked, Converter={StaticResource BooleanToVisibilityConverterFalse}}"
                           Foreground="Orange"
                           Icon="{ui:SymbolIcon LockOpen24}"
                           ToolTip="{DynamicResource settings.tooltip.replayLock}"
                           CommandParameter="{Binding Id}"
                           Command="{Binding ViewModel.ReplayLockCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                <ui:Button Padding="0"
                           Width="30"
                           Height="30"
                           Visibility="{Binding Locked, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Foreground="Red"
                           Icon="{ui:SymbolIcon LockClosed24}"
                           ToolTip="{DynamicResource settings.tooltip.replayUnlock}"
                           CommandParameter="{Binding Id}"
                           Command="{Binding ViewModel.ReplayUnlockCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Page>
