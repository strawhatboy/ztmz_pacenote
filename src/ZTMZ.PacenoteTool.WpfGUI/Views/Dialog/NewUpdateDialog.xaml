<ui:ContentDialog x:Class="ZTMZ.PacenoteTool.WpfGUI.Views.Dialog.NewUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ZTMZ.PacenoteTool.WpfGUI.Views.Dialog"
        mc:Ignorable="d"
        Title=""
        PrimaryButtonText="{DynamicResource ResourceKey=dialog.newUpdate.btn_ok}"
        CloseButtonText="{DynamicResource ResourceKey=dialog.newUpdate.btn_cancel}"
        IsPrimaryButtonEnabled="True"
        IsSecondaryButtonEnabled="False"
        DialogWidth="960"
        DialogHeight="680"
        DialogMaxWidth="960"
        DialogMaxHeight="720"
        DialogMargin="24"
        Loaded="OnLoaded"
        Unloaded="OnUnloaded"
        >
    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type local:NewUpdateDialog}" />
    </ui:ContentDialog.Resources>

    <ui:ContentDialog.TitleTemplate>
        <DataTemplate>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <ui:SymbolIcon Symbol="PhoneUpdate20" Margin="0 0 10 0" Foreground="LightSeaGreen" DockPanel.Dock="Left" VerticalAlignment="Center"  />
                <ui:TextBlock DockPanel.Dock="Top" Text="{DynamicResource ResourceKey=dialog.newUpdate.title}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </ui:ContentDialog.TitleTemplate>

    <Grid x:Name="ChangelogLayout" Height="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="tb_content" TextWrapping="Wrap" />
        <WebBrowser x:Name="wb_Changelog" Grid.Row="1" Margin="0,12,0,12" />
        <CheckBox x:Name="chkbox_skip" Grid.Row="2" HorizontalAlignment="Right"
                  Content="{DynamicResource ResourceKey=dialog.newUpdate.chkbox_skip}" Click="chkbox_skip_Click" />
    </Grid>
</ui:ContentDialog>
