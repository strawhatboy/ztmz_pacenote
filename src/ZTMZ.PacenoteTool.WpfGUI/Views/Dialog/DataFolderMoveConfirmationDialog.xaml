<ui:ContentDialog x:Class="ZTMZ.PacenoteTool.WpfGUI.Views.Dialog.DataFolderMoveConfirmationDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:ZTMZ.PacenoteTool.WpfGUI.Views.Dialog"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  CloseButtonText="{DynamicResource ResourceKey=dataFolderMigration.cancel}"
                  DialogMaxWidth="720"
                  IsPrimaryButtonEnabled="True"
                  IsSecondaryButtonEnabled="False"
                  PrimaryButtonText="{DynamicResource ResourceKey=dataFolderMigration.start}"
                  mc:Ignorable="d">
    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
               TargetType="{x:Type local:DataFolderMoveConfirmationDialog}" />
    </ui:ContentDialog.Resources>

    <ui:ContentDialog.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Margin="0,0,10,0" Symbol="FolderSwap20" VerticalAlignment="Center" />
                <ui:TextBlock Text="{DynamicResource ResourceKey=dataFolderMigration.title}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </ui:ContentDialog.TitleTemplate>

    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
</ui:ContentDialog>
