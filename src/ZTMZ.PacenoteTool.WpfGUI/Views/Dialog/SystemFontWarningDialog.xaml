<ui:ContentDialog x:Class="ZTMZ.PacenoteTool.WpfGUI.Views.Dialog.SystemFontWarningDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:ZTMZ.PacenoteTool.WpfGUI.Views.Dialog"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  CloseButtonText="{DynamicResource ResourceKey=dialog.common.btn_cancel}"
                  DialogMaxWidth="600"
                  IsPrimaryButtonEnabled="True"
                  IsSecondaryButtonEnabled="False"
                  PrimaryButtonText="{DynamicResource ResourceKey=dialog.common.btn_ok}">
    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
               TargetType="{x:Type local:SystemFontWarningDialog}" />
    </ui:ContentDialog.Resources>

    <ui:ContentDialog.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Margin="0,0,10,0" Symbol="Alert20" VerticalAlignment="Center" />
                <ui:TextBlock Text="{DynamicResource ResourceKey=font.systemFontWarningTitle}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </ui:ContentDialog.TitleTemplate>

    <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
</ui:ContentDialog>
