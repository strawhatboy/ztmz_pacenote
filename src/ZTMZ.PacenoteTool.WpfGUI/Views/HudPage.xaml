<Page x:Class="ZTMZ.PacenoteTool.WpfGUI.Views.HudPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ZTMZ.PacenoteTool.WpfGUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helper="clr-namespace:ZTMZ.PacenoteTool.WpfGUI.Helpers"
    Title="HudPage"
    FontFamily="{DynamicResource AppFontFamily}"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helper:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <!-- <Style TargetType="ui:Card">
            <Setter Property="Padding" Value="16"></Setter>
            <Setter Property="Margin" Value="0 0 0 5"></Setter>
        </Style> -->
    </Page.Resources>
    <StackPanel Orientation="Vertical">
        <!-- FPS -->
        <ui:Card Margin="0 0 0 3"
            Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Fps6020"
                            FontSize="26"
                            Margin="0 0 10 0" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <ui:TextBlock
                                Text="{DynamicResource ResourceKey=settings.hudFPS}" />
                            <ui:TextBlock Grid.Row="1"
                                Text="{DynamicResource ResourceKey=settings.tooltip.hudFPS}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                FontTypography="Caption" />
                        </Grid>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Right"
                        IsChecked="{Binding Path=ViewModel.HudLockFPS, Mode=TwoWay}" />

                </Grid>
                <Border Grid.Row="1"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="{Binding Path=ViewModel.HudLockFPS, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                    Background="Transparent">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Text="{Binding Path=ViewModel.HudFPS, Mode=OneWay, StringFormat=N0}"
                            Grid.Column="1" VerticalAlignment="Center" />
                        <Slider Grid.Row="0" Grid.Column="2"
                            Maximum="240" Minimum="30"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Path=ViewModel.HudFPS, Mode=TwoWay}"
                            IsEnabled="{Binding Path=ViewModel.HudLockFPS, Mode=OneWay}"
                            TickFrequency="30"
                            TickPlacement="Both"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </ui:Card>
        
        <!-- HudTopMost -->
        <ui:Card Margin="0 0 0 3"
            Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="BorderTop20"
                        FontSize="26"
                        Margin="0 0 10 0" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <ui:TextBlock
                            Text="{DynamicResource ResourceKey=settings.hudTopMost}" />
                        <ui:TextBlock Grid.Row="1"
                            Text="{DynamicResource ResourceKey=settings.tooltip.hudTopMost}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            FontTypography="Caption" />
                    </Grid>
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Right"
                    IsChecked="{Binding Path=ViewModel.HudTopMost, Mode=TwoWay}" />
            </Grid>
        </ui:Card>

        <!-- show in separated window -->
        <ui:CardAction Margin="0 0 0 3" Command="{Binding ViewModel.ShowInSeparateWindowCommand}" IsEnabled="{Binding ViewModel.IsHudInitializing, Converter={StaticResource InverseBooleanConverter}}" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Share20"
                        FontSize="26"
                        Margin="0 0 10 0" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <ui:TextBlock
                            Text="{DynamicResource ResourceKey=settings.hudShowInSeparateWindow}" />
                        <ui:TextBlock Grid.Row="1"
                            Text="{DynamicResource ResourceKey=settings.tooltip.hudShowInSeparateWindow}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            FontTypography="Caption" />
                    </Grid>
                </StackPanel>
                
                <ui:ProgressRing Visibility="{Binding ViewModel.IsHudInitializing, Converter={StaticResource BooleanToVisibilityConverter}}" 
                    Grid.Column="1" IsIndeterminate="True" HorizontalAlignment="Right" />
            </Grid>
        </ui:CardAction>

        <!-- Web Dashboard -->
        <ui:Card Margin="0 0 0 3" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Globe20" FontSize="26" Margin="0 0 10 0" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" Text="{DynamicResource ResourceKey=settings.tooltip.webDashboardTitle}" FontTypography="BodyStrong" />
                        <ui:TextBlock Grid.Row="1" Text="{DynamicResource ResourceKey=settings.tooltip.webDashboardSubtitle}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontTypography="Caption" />
                    </Grid>
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Path=ViewModel.WebDashboardEnabled, Mode=TwoWay}" ToolTip="{DynamicResource ResourceKey=settings.tooltip.webDashboardEnabled}" HorizontalAlignment="Right" />
                
                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="36 10 0 0"
                      VerticalAlignment="Center"
                      Visibility="{Binding Path=ViewModel.WebDashboardEnabled, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Column="0"
                                  Text="{DynamicResource ResourceKey=settings.tooltip.webDashboardPortLabel}"
                                  VerticalAlignment="Center"
                                  Margin="0 0 8 0" />
                    <ui:NumberBox Grid.Column="1"
                                  Width="168"
                                  Value="{Binding Path=ViewModel.WebDashboardPort, Mode=TwoWay}"
                                  Minimum="1024"
                                  Maximum="65535"
                                  ToolTip="{DynamicResource ResourceKey=settings.tooltip.webDashboardPort}" />
                    <ui:TextBlock Grid.Column="2"
                                  Text="{DynamicResource ResourceKey=settings.tooltip.webDashboardFrameRateLabel}"
                                  VerticalAlignment="Center"
                                  Margin="12 0 8 0" />
                    <ui:TextBlock Grid.Column="3"
                                  Text="{Binding Path=ViewModel.WebDashboardFrameRate, Mode=OneWay, StringFormat=N0}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Margin="0 0 8 0" />
                    <Slider Grid.Column="4"
                            Maximum="240"
                            Minimum="5"
                            IsSnapToTickEnabled="True"
                            SmallChange="5"
                            LargeChange="5"
                            TickFrequency="5"
                            TickPlacement="Both"
                            Value="{Binding Path=ViewModel.WebDashboardFrameRate, Mode=TwoWay}"
                            ToolTip="{DynamicResource ResourceKey=settings.tooltip.webDashboardFrameRate}"
                            VerticalAlignment="Center"
                            Margin="0 0 16 0" />
                    <StackPanel Grid.Column="5"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <ui:TextBlock Text="{DynamicResource ResourceKey=settings.tooltip.webDashboardBrowserLuaLabel}"
                                      VerticalAlignment="Center"
                                      Margin="0 0 8 0" />
                        <ui:ToggleSwitch IsChecked="{Binding Path=ViewModel.WebDashboardBrowserLuaEnabled, Mode=TwoWay}"
                                         VerticalAlignment="Center"
                                         ToolTip="{DynamicResource ResourceKey=settings.tooltip.webDashboardBrowserLuaEnabled}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Grid.ColumnSpan="6"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0 8 0 0">
                        <Ellipse Width="8"
                             Height="8"
                             Fill="{Binding Path=ViewModel.WebDashboardStatusBrush, Mode=OneWay}"
                             VerticalAlignment="Center"
                             Margin="0 0 7 0"
                             ToolTip="{Binding Path=ViewModel.WebDashboardStatus, Mode=OneWay}"
                             ToolTipService.InitialShowDelay="100" />
                        <ui:Button MaxWidth="260"
                                   HorizontalContentAlignment="Stretch"
                                   Icon="{ui:SymbolIcon Open20}"
                                   Command="{Binding Path=ViewModel.OpenWebDashboardCommand}"
                                   ToolTip="{DynamicResource ResourceKey=settings.tooltip.webDashboardOpen}">
                            <ui:TextBlock Text="{Binding Path=ViewModel.WebDashboardUrl, Mode=OneWay}"
                                          TextWrapping="NoWrap"
                                          TextTrimming="CharacterEllipsis" />
                        </ui:Button>
                        <ui:SymbolIcon Symbol="QuestionCircle20"
                                       FontSize="18"
                                       Margin="8 0 0 0"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding Path=ViewModel.WebDashboardAddressesTooltip, Mode=OneWay}"
                                       ToolTipService.InitialShowDelay="100" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ui:Card>

        <ui:TextBlock
            Text="{DynamicResource ResourceKey=tabs.dashboard}"
            Margin="0 0 0 5"
            FontTypography="Subtitle" />

        <!-- Dashboards -->
        <ItemsControl x:Name="tStack" ItemsSource="{Binding ViewModel.DashboardItems}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</Page>
