<local:IGameConfigSettingsPane x:Class="ZTMZ.PacenoteTool.AC.ACRExperimentalBridgeConfigSettingsPane"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ZTMZ.PacenoteTool.Base.UI.Game;assembly=ZTMZ.PacenoteTool.Base.UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CheckBox x:Name="EnableControlsCheckBox"
                Content="{DynamicResource ResourceKey=game.acr.experimental.enable}"
                Checked="EnableControlsCheckBox_OnChecked"
                Unchecked="EnableControlsCheckBox_OnUnchecked" />

        <ui:TextBlock Grid.Row="1"
                Margin="0,8,0,0"
                Text="{DynamicResource ResourceKey=game.acr.experimental.privilegeWarning}"
                TextWrapping="Wrap" />

        <ui:TextBlock Grid.Row="2" x:Name="BridgeStatusTextBlock"
                Margin="0,8,0,8"
                TextWrapping="Wrap" />

        <ui:Button Grid.Row="3" x:Name="InjectButton"
                HorizontalAlignment="Left"
                Content="{DynamicResource ResourceKey=game.acr.experimental.inject}"
                Click="InjectButton_OnClick" />
    </Grid>
</local:IGameConfigSettingsPane>
